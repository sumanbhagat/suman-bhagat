# Enable rewrite engine
RewriteEngine On
RewriteBase /suman%20portfolio/

# Disable directory browsing
Options -Indexes

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|ini|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect admin includes folder
RewriteRule ^backend/admin/includes/ - [F,L]
RewriteRule ^backend/admin/database/ - [F,L]

# Clean URL Rewriting
# Route frontend pages to frontend directory
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)/?$ frontend/$1.php [L,QSA]

# Route admin pages to backend directory
RewriteRule ^admin/(.*)$ backend/admin/$1 [L,QSA]

# Blog post with slug (optional enhancement)
# RewriteRule ^blog/([^/]+)/?$ blog.php?slug=$1 [L,QSA]

# Portfolio project with slug (optional enhancement)
# RewriteRule ^portfolio/([^/]+)/?$ portfolio.php?slug=$1 [L,QSA]

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Force HTTPS (uncomment if SSL is enabled)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Custom error pages
ErrorDocument 404 /school/portfolio/frontend/404.php
ErrorDocument 403 /school/portfolio/frontend/403.php

# PHP settings (if mod_php is used)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
</IfModule>
